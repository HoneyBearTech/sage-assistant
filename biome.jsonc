{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/package-lock.json", "!dist", "!coverage", "!test/fixtures"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  // Off: the docs are hand-written prose, wrapped by hand; Biome 2.6 started formatting Markdown.
  "markdown": {
    "formatter": { "enabled": false }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        // Off: reordering every import is churn with no bug-catching value.
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      // Tests use `!` after assertions that have already proven the value exists, and read
      // untyped request bodies from the fake servers. src/ keeps both rules on.
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
