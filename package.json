{
  "name": "sage-assistant",
  "version": "0.1.1",
  "private": true,
  "description": "Sage: a desktop assistant that runs on your own computer, with a local or online brain and an ask-first rule for anything risky.",
  "license": "MIT",
  "author": "HoneyBearTech",
  "type": "module",
  "main": "dist/main.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoneyBearTech/sage-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/HoneyBearTech/sage-assistant/issues"
  },
  "homepage": "https://github.com/HoneyBearTech/sage-assistant#readme",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "preview": "npm run build && tsx scripts/preview.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=80 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/renderer",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . --error-on-warnings",
    "check:public": "tsx scripts/check-public.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "verify": "npm run check && npm run typecheck && npm run test:coverage && npm run check:public && npm run secret-scan"
  },
  "dependencies": {
    "sherpa-onnx-node": "2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "electron": "45.3.2",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch@^10.2.5": "11.0.8"
    },
    "@electron/universal": {
      "minimatch@^9.0.3": "11.0.8"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": false
  }
}
